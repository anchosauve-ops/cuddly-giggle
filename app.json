{
  "expo": {
    "name": "ENI Mobile",
    "slug": "eni-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "eni-mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "cc.eni.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0b"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication"
    ]
  }
}
